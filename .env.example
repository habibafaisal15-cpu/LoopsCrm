# Supabase Postgres — Project Settings → Database → Connection string
# Use the Transaction pooler URI for DATABASE_URL (port 6543).
# Use the Direct URI for DIRECT_URL (port 5432).
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-string"
